+
+/* V11: deterministic client-only dashboard boot screen. The real staff
+   workspace is loaded with next/dynamic({ ssr: false }) to eliminate SSR
+   hydration mismatches around GPS/browser-only functionality. */
+.clientBootShell {
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  padding: 32px;
+  background:
+    radial-gradient(circle at 20% 20%, rgba(24, 145, 92, 0.16), transparent 34%),
+    radial-gradient(circle at 82% 72%, rgba(21, 95, 170, 0.12), transparent 38%),
+    #f4f8f6;
+}
+
+.clientBootCard {
+  width: min(560px, 100%);
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: 20px;
+  padding: 24px 26px;
+  border: 1px solid rgba(14, 92, 62, 0.12);
+  border-radius: 24px;
+  background: rgba(255, 255, 255, 0.94);
+  box-shadow: 0 24px 70px rgba(16, 68, 49, 0.14);
+  backdrop-filter: blur(18px);
+}
+
+.clientBootMark {
+  width: 58px;
+  height: 58px;
+  display: grid;
+  place-items: center;
+  border-radius: 17px;
+  background: linear-gradient(145deg, #0d7b4c, #149b67);
+  color: #fff;
+  font-size: 20px;
+  font-weight: 900;
+  letter-spacing: 0.04em;
+  box-shadow: 0 12px 28px rgba(13, 123, 76, 0.22);
+}
+
+.clientBootCard small {
+  display: block;
+  margin-bottom: 5px;
+  color: #0d7b4c;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: 0.14em;
+}
+
+.clientBootCard h1 {
+  margin: 0;
+  color: #12372a;
+  font-size: 22px;
+  line-height: 1.15;
+}
+
+.clientBootCard p {
+  margin: 6px 0 0;
+  color: #6b7f76;
+  font-size: 13px;
+}
+
+.clientBootSpinner {
+  width: 24px;
+  height: 24px;
+  border: 3px solid rgba(13, 123, 76, 0.16);
+  border-top-color: #0d7b4c;
+  border-radius: 999px;
+  animation: staffClientBootSpin 0.8s linear infinite;
+}
+
+@keyframes staffClientBootSpin {
+  to { transform: rotate(360deg); }
+}
+
+@media (max-width: 640px) {
+  .clientBootShell { padding: 18px; }
+  .clientBootCard {
+    grid-template-columns: auto 1fr;
+    padding: 20px;
+    border-radius: 20px;
+  }
+  .clientBootSpinner { grid-column: 1 / -1; justify-self: center; }
+}
