// Merge this reference only when your main schema does not already contain
// BrokerServiceVisit and BrokerVisitStatus. The v2.0 API can work with older
// versions of the table, but these fields provide the complete experience.

enum BrokerVisitStatus {
  STARTED
  ARRIVED
  SERVICE_RECORDED
  PROOF_PENDING
  COMPLETED
  LATE_PROOF
  CANCELLED
}

model BrokerServiceVisit {
  id                String            @id @default(cuid())
  companyId         String
  staffId           String
  brokerCustomerId  String
  deviceId          String?
  serviceActivityId String?
  status            BrokerVisitStatus @default(STARTED)
  serviceType       String?
  communicationNote String?           @db.Text
  floatAmount       Decimal           @default(0) @db.Decimal(18, 2)
  cashAmount        Decimal           @default(0) @db.Decimal(18, 2)
  companyIncome     Decimal           @default(0) @db.Decimal(18, 2)
  staffLatitude     Float?
  staffLongitude    Float?
  brokerLatitude    Float?
  brokerLongitude   Float?
  distanceMeters    Float?
  locationMatched   Boolean           @default(false)
  startedAt         DateTime          @default(now())
  arrivedAt         DateTime?
  serviceProvidedAt DateTime?
  proofDueAt        DateTime?
  proofUploadedAt   DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   User           @relation("BrokerServiceVisitStaff", fields: [staffId], references: [id], onDelete: Cascade)
  broker  BrokerCustomer @relation(fields: [brokerCustomerId], references: [id], onDelete: Cascade)

  @@index([companyId, staffId, startedAt])
  @@index([brokerCustomerId, startedAt])
  @@index([status, startedAt])
  @@map("broker_service_visits")
}
