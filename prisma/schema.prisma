// -----------------------------------------------------------------------------
// Accountant workflow extension
// Added for the Simamia Float accountant, company-admin, staff, fingerprint,
// verification, and reporting routes. The models store scalar IDs so they can be
// added without changing the existing Company/User relation graph.
// -----------------------------------------------------------------------------

enum AccountantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountantReviewerRole {
  ACCOUNTANT
  COMPANY_ADMIN
}

enum AccountantFundingStatus {
  ISSUED
  CONFIRMED
  RETURNED
  VERIFIED
  REJECTED
  CANCELLED
}

enum AccountantAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HOLIDAY
}

enum AccountantAttendanceSource {
  ACCOUNTANT
  FINGERPRINT
}

enum AccountantAttendanceOverall {
  NOT_MARKED
  PARTIAL
  PRESENT
  ABSENT
  MIXED
}

enum AccountantVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AccountantPacketTarget {
  PROOF
  BANK_DEPOSIT
  EXPENSE
  OTHER
}

enum AccountantBankStatus {
  PENDING
  VERIFIED
  REJECTED
  AMOUNT_MISMATCH
  REFERENCE_MISMATCH
  DATE_MISMATCH
  ACCOUNT_MISMATCH
  MISSING_RECEIPT
  MISSING_BANK_RECORD
}

enum AccountantIncomeStatus {
  COMPLETED
  VOID
}

enum AccountantNotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum AccountantPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum AccountantReopenStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccAttendanceSession {
  MORNING
  EVENING
}

enum AccAttendanceMark {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AccAttendanceSource {
  ACCOUNTANT_MANUAL
  FINGERPRINT
  IMPORTED
}

enum AccDecision {
  PENDING
  APPROVE
  REJECT
}

enum AccMoneyKind {
  FLOAT
  CASH
}

enum AccMoneyDirection {
  ALLOCATE
  RECEIVE
  RETURN
  ADJUSTMENT
}

enum AccVerificationKind {
  SMS
  PROOF
  DOCUMENT
  BANK_REFERENCE
}

enum AccVerificationStatus {
  WAITING_ADMIN_REFERENCE
  READY_FOR_ACCOUNTANT
  VERIFIED
  REJECTED
}

