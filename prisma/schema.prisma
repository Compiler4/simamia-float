generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SYSTEM_DEVELOPER
  SUPER_ADMIN
  COMPANY_ADMIN
  ACCOUNTANT
  STAFF
  BROKER
  GPS_MANAGER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FinancialDayStatus {
  OPEN
  CLOSED
  BLOCKED
}

enum DepositStatus {
  PENDING
  VERIFIED
  AMOUNT_MISMATCH
  MISSING_RECEIPT
  DUPLICATE_DEPOSIT
  MISSING_BANK_RECORD
}

enum FloatStatus {
  PENDING
  ISSUED
  CONFIRMED
  RETURNED
  DEPOSITED
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/**
 * Company Admin workflow enums.
 * These are intentionally separate from the existing ERP enums so the
 * additional dashboard module can evolve without changing the behavior of
 * the original Expense, BankDeposit and Attendance tables.
 */
enum CompanyExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyBankStatus {
  PENDING
  VERIFIED
  AMOUNT_MISMATCH
  MISSING_RECEIPT
  DUPLICATE_DEPOSIT
  MISSING_BANK_RECORD
  REJECTED
}

enum CompanyAttendanceMark {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
}

enum CompanyGpsDeviceStatus {
  ACTIVE
  INACTIVE
}

enum BrokerCustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
}

enum StaffFloatType {
  ACCOUNTANT_TO_STAFF
  STAFF_TO_BROKER
  BROKER_RETURN_TO_STAFF
  STAFF_RETURN_TO_ACCOUNTANT
}

enum StaffCollectionStatus {
  PENDING
  VERIFIED
  REJECTED
  DEPOSITED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum GpsAlertType {
  GPS_DISABLED
  EMPLOYEE_OFFLINE
  LEFT_ASSIGNED_REGION
  OVERSPEED
  LONG_IDLE_TIME
}

enum GpsAlertStatus {
  OPEN
  RESOLVED
}

enum StaffAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum StaffFileKind {
  PROFILE
  RECEIPT
  PROOF
  EXPENSE
  BANK
  OTHER
}

enum ImportedDataSourceType {
  EXCEL_AGENT_MASTER
  BANK_STATEMENT_PDF
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum BankStatementTransactionDirection {
  CREDIT
  DEBIT
}

enum BankTransactionMatchStatus {
  MATCHED
  REVIEW_REQUIRED
  UNMATCHED
  NOT_APPLICABLE
}

enum BrokerServiceVisitStatus {
  STARTED
  ARRIVED
  SERVICE_RECORDED
  PROOF_PENDING
  COMPLETED
  LATE_PROOF
  CANCELLED
}

enum LocationRecordSource {
  IMPORTED
  MANUAL
  STAFF_GPS
  BROKER_GPS
  CUSTOMER_GPS
}

enum MobileNetwork {
  VODACOM
  YAS_MIX
  AIRTEL
  HALOTEL
  OTHER
}

enum ProofInspectionStatus {
  PENDING
  CHECKING
  SUFFICIENT
  INSUFFICIENT
  MANUAL_REVIEW
  ERROR
}

enum PortalDocumentKind {
  PROFILE_IMAGE
  SMS_SCREENSHOT
  BANK_SLIP
  BANK_RECEIPT
  BANK_STATEMENT
  PDF
  DOCUMENT
  IMAGE
  SERVICE_PROOF
  EXPENSE_RECEIPT
  SIGNATURE
  OTHER
}

enum ApprovalItemType {
  EXPENSE
  BANK_VERIFICATION
}

enum ApprovalDecisionValue {
  PENDING
  APPROVED
  REJECTED
}

enum StaffNetworkPurpose {
  FLOAT
  CASH
  BOTH
}

enum StaffNetworkLineStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StaffFundingReceiptStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum StaffProofDirection {
  ACCOUNTANT_TO_STAFF
  STAFF_TO_BROKER
  BROKER_TO_STAFF
  STAFF_TO_ACCOUNTANT
  STAFF_TO_BANK
  EXPENSE_PAYMENT
  OTHER
}

enum StaffProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AttendanceSession {
  MORNING
  EVENING
}

enum AttendanceDeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum AttendancePunchStatus {
  ACCEPTED
  REJECTED
  REVIEW_REQUIRED
}

enum VerificationTargetType {
  STAFF_PROOF
  BANK_DEPOSIT
  EXPENSE
  OTHER
}

enum VerificationPacketStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Company {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique
  email     String?
  phone     String?
  address   String?
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  branches           Branch[]
  users              User[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  financialDays      FinancialDay[]
  bankDeposits       BankDeposit[]
  expenses           Expense[]
  floatTransactions  FloatTransaction[]
  attendanceRecords  Attendance[]
  performanceRecords PerformanceRecord[]
  notifications      Notification[]
  messages           Message[]
  products           Product[]
  customers          Customer[]
  brokerCustomers    BrokerCustomer[]
  serviceActivities  ServiceActivity[]
  gpsTrackings       GpsTracking[]
  companySettings    CompanySetting[]

  /**
   * New Company Admin portal relations.
   * The field names are different from the existing ERP relations to avoid
   * collisions and to keep both modules available during migration.
   */
  adminExpenses                  CompanyExpense[]
  adminBankVerifications         CompanyBankVerification[]
  adminBankMessages              CompanyBankMessage[]
  adminAttendanceJournal         CompanyAttendance[]
  adminNotifications             CompanyNotification[]
  adminGpsDevices                CompanyGpsDevice[]
  adminGpsPings                  CompanyGpsPing[]
  adminSetting                   CompanyAdminSetting?
  adminAuditEvents               CompanyAuditEvent[]
  accountingPeriods              AccountingPeriod[]
  staffCollections               StaffCollection[]
  gpsAlerts                      GpsAlert[]
  notificationDeliveries         NotificationDelivery[]
  staffBrokerAssignments         StaffBrokerAssignment[]
  staffCustomerAssignments       StaffCustomerAssignment[]
  staffFiles                     StaffFile[]
  dataImportBatches              DataImportBatch[]
  importedBankStatements         ImportedBankStatement[]
  importedBankTransactions       ImportedBankTransaction[]
  brokerAgentAccounts            BrokerAgentAccount[]
  portalDocuments                PortalDocument[]
  approvalDecisions              ApprovalDecision[]
  networkBalances                NetworkBalance[]
  staffNetworkLines              StaffNetworkLine[]
  staffFundingReceipts           StaffFundingReceipt[]
  staffProofSubmissions          StaffProofSubmission[]
  staffWorkAreas                 StaffWorkArea[]
  staffBrokerCustomerAssignments StaffBrokerCustomerAssignment[]
  brokerServiceVisits            BrokerServiceVisit[]

  @@map("companies")
}

model Branch {
  id        String       @id @default(cuid())
  companyId String
  name      String
  code      String
  region    String?
  address   String?
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model User {
  id                String     @id @default(cuid())
  companyId         String?
  branchId          String?
  name              String
  username          String     @unique
  email             String     @unique
  phone             String?
  passwordHash      String     @db.Text
  role              Role
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  profileImageUrl   String?    @db.VarChar(500)
  assignedRegion    String?    @db.VarChar(150)
  nidaNumber        String?    @unique @db.VarChar(40)
  dateOfBirth       DateTime?
  gender            String?    @db.VarChar(40)
  nationality       String?    @db.VarChar(80)
  physicalAddress   String?    @db.VarChar(255)
  usernameChangedAt DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  attendanceRecords  Attendance[]
  performanceRecords PerformanceRecord[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  servicesAsStaff  ServiceActivity[] @relation("ServiceStaff")
  servicesAsBroker ServiceActivity[] @relation("ServiceBroker")
  gpsTrackings     GpsTracking[]

  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")

  openedFinancialDays FinancialDay[] @relation("FinancialDayOpenedBy")
  closedFinancialDays FinancialDay[] @relation("FinancialDayClosedBy")

  depositsSubmitted BankDeposit[] @relation("DepositStaff")
  depositsReviewed  BankDeposit[] @relation("DepositAccountant")

  expensesSubmitted Expense[] @relation("ExpenseEmployee")
  expensesReviewed  Expense[] @relation("ExpenseReviewer")

  floatSent      FloatTransaction[] @relation("FloatFrom")
  floatReceived  FloatTransaction[] @relation("FloatTo")
  floatsApproved FloatTransaction[] @relation("FloatApprovedBy")

  staffCollectionsRecorded      StaffCollection[]               @relation("StaffCollectionOfficer")
  brokerCollections             StaffCollection[]               @relation("StaffCollectionBroker")
  staffCollectionsVerified      StaffCollection[]               @relation("StaffCollectionVerifier")
  gpsAlerts                     GpsAlert[]                      @relation("GpsAlertUser")
  notificationDeliveries        NotificationDelivery[]          @relation("NotificationDeliveryUser")
  brokerAssignmentsAsStaff      StaffBrokerAssignment[]         @relation("StaffBrokerAssignmentStaff")
  assignmentsAsBroker           StaffBrokerAssignment[]         @relation("StaffBrokerAssignmentBroker")
  brokerAssignmentsCreated      StaffBrokerAssignment[]         @relation("StaffBrokerAssignmentCreator")
  customerAssignmentsAsStaff    StaffCustomerAssignment[]       @relation("StaffCustomerAssignmentStaff")
  customerAssignmentsCreated    StaffCustomerAssignment[]       @relation("StaffCustomerAssignmentCreator")
  ownedStaffFiles               StaffFile[]                     @relation("StaffFileOwner")
  uploadedPortalDocuments       PortalDocument[]                @relation("PortalDocumentUploader")
  approvalDecisions             ApprovalDecision[]              @relation("ApprovalDecisionReviewer")
  assignedNetworkLines          StaffNetworkLine[]              @relation("StaffNetworkLineOwner")
  receivedFundingReceipts       StaffFundingReceipt[]           @relation("StaffFundingReceiptStaff")
  issuedFundingReceipts         StaffFundingReceipt[]           @relation("StaffFundingReceiptAccountant")
  submittedProofs               StaffProofSubmission[]          @relation("StaffProofSubmissionStaff")
  verifiedProofs                StaffProofSubmission[]          @relation("StaffProofSubmissionVerifier")
  staffWorkAreas                StaffWorkArea[]                 @relation("StaffWorkAreaStaff")
  brokerCustomerAssignments     StaffBrokerCustomerAssignment[] @relation("StaffBrokerCustomerAssignmentStaff")
  brokerCustomerAssignmentsMade StaffBrokerCustomerAssignment[] @relation("StaffBrokerCustomerAssignmentCreator")
  brokerServiceVisits           BrokerServiceVisit[]            @relation("BrokerServiceVisitStaff")

  /**
   * New Company Admin portal relations.
   */
  adminExpensesCreated    CompanyExpense[]          @relation("CompanyExpenseCreatedBy")
  adminExpensesReviewed   CompanyExpense[]          @relation("CompanyExpenseReviewedBy")
  adminBankUploads        CompanyBankVerification[] @relation("CompanyBankUploadedBy")
  adminBankReviews        CompanyBankVerification[] @relation("CompanyBankVerifiedBy")
  adminBankMessages       CompanyBankMessage[]      @relation("CompanyBankMessageSender")
  adminAttendanceRecords  CompanyAttendance[]
  adminNotifications      CompanyNotification[]     @relation("CompanyNotificationTarget")
  adminGpsDevices         CompanyGpsDevice[]        @relation("CompanyGpsDeviceOwner")
  adminAuditEvents        CompanyAuditEvent[]       @relation("CompanyAuditActor")
  accountingPeriodsLocked AccountingPeriod[]        @relation("AccountingPeriodLockedBy")
  depositHoldsCleared     BankDeposit[]             @relation("DepositHoldClearedBy")

  @@index([companyId])
  @@index([branchId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Subscription {
  id        String   @id @default(cuid())
  companyId String
  plan      String
  amount    Decimal  @default(0) @db.Decimal(18, 2)
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("subscriptions")
}

model FinancialDay {
  id             String             @id @default(cuid())
  companyId      String
  date           DateTime
  openingBalance Decimal            @default(0) @db.Decimal(18, 2)
  cashIn         Decimal            @default(0) @db.Decimal(18, 2)
  cashOut        Decimal            @default(0) @db.Decimal(18, 2)
  closingBalance Decimal            @default(0) @db.Decimal(18, 2)
  status         FinancialDayStatus @default(OPEN)
  blockedReason  String?            @db.Text
  openedById     String?
  closedById     String?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedBy User?   @relation("FinancialDayOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy User?   @relation("FinancialDayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([companyId, date])
  @@index([companyId])
  @@map("financial_days")
}

model Attendance {
  id            String           @id @default(cuid())
  companyId     String?
  userId        String
  date          DateTime
  status        AttendanceStatus @default(PRESENT)
  checkInAt     DateTime?
  checkOutAt    DateTime?
  source        String           @default("SYSTEM_ACTIVITY")
  notes         String?          @db.Text
  morningStatus String?          @db.VarChar(40)
  eveningStatus String?          @db.VarChar(40)
  morningSource String?          @db.VarChar(80)
  eveningSource String?          @db.VarChar(80)
  markedById    String?          @db.VarChar(191)
  verifiedById  String?          @db.VarChar(191)
  verifiedAt    DateTime?
  deviceId      String?          @db.VarChar(191)
  overallStatus String?          @db.VarChar(40)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId])
  @@index([companyId, date])
  @@index([status])
  @@map("attendance")
}

model Expense {
  id              String         @id @default(cuid())
  companyId       String
  employeeId      String
  createdById     String?
  reviewedById    String?
  expenseDate     DateTime       @default(now())
  category        String
  otherCategory   String?        @db.VarChar(191)
  requestMode     String         @default("REIMBURSEMENT") @db.VarChar(80)
  requestedAction String?        @db.Text
  amount          Decimal        @db.Decimal(18, 2)
  description     String?        @db.Text
  receiptUrl      String?
  status          ApprovalStatus @default(PENDING)
  reviewNote      String?        @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   User    @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([companyId, expenseDate])
  @@index([employeeId])
  @@index([createdById])
  @@index([status])
  @@map("expenses")
}

model BankDeposit {
  id                   String        @id @default(cuid())
  companyId            String
  staffId              String
  accountantId         String?
  amount               Decimal       @db.Decimal(18, 2)
  referenceNo          String?
  bankAccount          String?
  depositDate          DateTime
  depositSlipUrl       String?
  bankReceiptUrl       String?
  bankStatementUrl     String?
  statementAmount      Decimal?      @db.Decimal(18, 2)
  statementReference   String?       @db.VarChar(191)
  statementDate        DateTime?
  statementBankAccount String?       @db.VarChar(191)
  comparisonJson       String?       @db.LongText
  comparedAt           DateTime?
  holdActive           Boolean       @default(false)
  status               DepositStatus @default(PENDING)
  mismatchReason       String?       @db.Text
  reviewedAt           DateTime?
  holdClearedAt        DateTime?
  holdClearedById      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff         User    @relation("DepositStaff", fields: [staffId], references: [id], onDelete: Cascade)
  accountant    User?   @relation("DepositAccountant", fields: [accountantId], references: [id], onDelete: SetNull)
  holdClearedBy User?   @relation("DepositHoldClearedBy", fields: [holdClearedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([staffId])
  @@index([status])
  @@index([holdClearedById])
  @@map("bank_deposits")
}

model FloatTransaction {
  id               String         @id @default(cuid())
  companyId        String
  fromUserId       String?
  toUserId         String?
  approvedById     String?
  brokerCustomerId String?
  transactionType  StaffFloatType @default(ACCOUNTANT_TO_STAFF)
  referenceNo      String?
  amount           Decimal        @db.Decimal(18, 2)
  returnedAmount   Decimal?       @db.Decimal(18, 2)
  purpose          String?        @db.Text
  receiptUrl       String?        @db.VarChar(500)
  notes            String?        @db.Text
  status           FloatStatus    @default(PENDING)
  issuedAt         DateTime?
  confirmedAt      DateTime?
  returnedAt       DateTime?
  approvedAt       DateTime?
  lockedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromUser       User?           @relation("FloatFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser         User?           @relation("FloatTo", fields: [toUserId], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("FloatApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  brokerCustomer BrokerCustomer? @relation(fields: [brokerCustomerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  fundingReceipt StaffFundingReceipt?

  @@unique([companyId, referenceNo])
  @@index([companyId, transactionType, status])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([approvedById])
  @@index([brokerCustomerId])
  @@index([createdAt])
  @@map("float_transactions")
}

model StaffCollection {
  id               String                @id @default(cuid())
  companyId        String
  staffId          String
  brokerId         String?
  brokerCustomerId String?
  reviewedById     String?
  referenceNo      String
  amount           Decimal               @db.Decimal(18, 2)
  collectionDate   DateTime
  description      String?               @db.Text
  receiptUrl       String?               @db.VarChar(500)
  status           StaffCollectionStatus @default(PENDING)
  reviewNote       String?               @db.Text
  reviewedAt       DateTime?
  depositedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff          User            @relation("StaffCollectionOfficer", fields: [staffId], references: [id], onDelete: Restrict)
  broker         User?           @relation("StaffCollectionBroker", fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCustomer BrokerCustomer? @relation(fields: [brokerCustomerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy     User?           @relation("StaffCollectionVerifier", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([companyId, referenceNo])
  @@index([companyId, collectionDate])
  @@index([staffId, status])
  @@index([brokerId])
  @@index([brokerCustomerId])
  @@index([reviewedById])
  @@map("staff_collections")
}

model PerformanceRecord {
  id                     String   @id @default(cuid())
  companyId              String
  userId                 String
  month                  Int
  year                   Int
  totalFloatIssued       Decimal  @default(0) @db.Decimal(18, 2)
  totalCollections       Decimal  @default(0) @db.Decimal(18, 2)
  outstandingBalance     Decimal  @default(0) @db.Decimal(18, 2)
  attendanceRate         Decimal  @default(0) @db.Decimal(5, 2)
  depositAccuracyRate    Decimal  @default(0) @db.Decimal(5, 2)
  gpsComplianceRate      Decimal  @default(0) @db.Decimal(5, 2)
  averageReturnMinutes   Decimal  @default(0) @db.Decimal(10, 2)
  bankMismatches         Int      @default(0)
  customerVisits         Int      @default(0)
  brokerVisits           Int      @default(0)
  transactionsCompleted  Int      @default(0)
  approvalComplianceRate Decimal  @default(0) @db.Decimal(5, 2)
  score                  Int      @default(0)
  rating                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([companyId])
  @@map("performance_records")
}

model Notification {
  id        String           @id @default(cuid())
  companyId String?
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  company    Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([companyId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Message {
  id         String   @id @default(cuid())
  companyId  String?
  senderId   String
  receiverId String
  subject    String
  body       String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  company  Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sender   User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("messages")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  module    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([module])
  @@map("audit_logs")
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  category    String?
  price       Decimal  @default(0) @db.Decimal(18, 2)
  stock       Int      @default(0)
  status      String   @default("ACTIVE")
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("products")
}

model Customer {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  phone        String?
  email        String?
  region       String?
  district     String?
  ward         String?
  address      String?
  locationName String?  @db.VarChar(191)
  latitude     Float?
  longitude    Float?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceActivities ServiceActivity[]
  staffAssignments  StaffCustomerAssignment[]

  @@index([companyId])
  @@map("customers")
}

model BrokerCustomer {
  id                   String               @id @default(cuid())
  companyId            String
  code                 String
  title                String?              @db.VarChar(40)
  firstName            String?              @db.VarChar(120)
  surname              String?              @db.VarChar(120)
  name                 String
  businessName         String?
