model AccountantStaffFunding {
  id             String                  @id @default(cuid())
  companyId      String
  staffId        String
  issuedById     String
  floatAmount    Decimal                 @default(0) @db.Decimal(18, 2)
  cashAmount     Decimal                 @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal                 @default(0) @db.Decimal(18, 2)
  referenceNo    String
  purpose        String?
  note           String?                 @db.Text
  status         AccountantFundingStatus @default(ISSUED)
  issuedAt       DateTime                @default(now())
  confirmedAt    DateTime?
  receiptUrl     String?                 @db.Text
  returnedAmount Decimal?                @db.Decimal(18, 2)
  returnedAt     DateTime?
  returnReason   String?                 @db.Text
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([companyId, referenceNo])
  @@index([companyId, issuedAt])
  @@index([companyId, staffId])
  @@index([companyId, status])
  @@map("accountant_staff_fundings")
}

model AccountantAttendance {
  id            String                      @id @default(cuid())
  companyId     String
  userId        String
  date          DateTime                    @db.Date
  morningStatus AccountantAttendanceStatus?
  eveningStatus AccountantAttendanceStatus?
  morningSource AccountantAttendanceSource?
  eveningSource AccountantAttendanceSource?
  checkInAt     DateTime?
  checkOutAt    DateTime?
  notes         String?                     @db.Text
  markedById    String?
  overallStatus AccountantAttendanceOverall @default(NOT_MARKED)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([companyId, userId, date])
  @@index([companyId, date])
  @@index([companyId, userId])
  @@map("accountant_attendance")
}

model AccountantAttendanceSessionRecord {
  id             String               @id @default(cuid())
  companyId      String
  staffId        String
  attendanceDate DateTime             @db.Date
  session        AccAttendanceSession
  mark           AccAttendanceMark    @default(PRESENT)
  source         AccAttendanceSource  @default(ACCOUNTANT_MANUAL)
  checkedAt      DateTime             @default(now())
  checkedById    String
  deviceId       String?
  note           String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, staffId, attendanceDate, session])
  @@index([companyId, attendanceDate])
  @@index([companyId, staffId])
  @@map("accountant_attendance_sessions")
}

model AccountantFingerprintDevice {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  serialNumber    String
  vendor          String?
  location        String?
  locationLabel   String?
  status          String    @default("ACTIVE") @db.VarChar(32)
  secretHash      String?   @db.VarChar(128)
  accessTokenHash String?   @db.VarChar(128)
  createdById     String?
  registeredById  String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, serialNumber])
  @@index([companyId, status])
  @@map("accountant_fingerprint_devices")
}

model AccountantFingerprintEnrollment {
  id               String   @id @default(cuid())
  companyId        String
  deviceId         String
  userId           String?
  staffId          String?
  externalUserCode String?
  templateKey      String?  @db.VarChar(191)
  fingerLabel      String?
  active           Boolean  @default(true)
  enrolledById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([deviceId, externalUserCode])
  @@unique([deviceId, userId])
  @@unique([companyId, deviceId, staffId])
  @@unique([companyId, deviceId, templateKey])
  @@index([companyId, staffId])
  @@index([companyId, userId])
  @@map("accountant_fingerprint_enrollments")
}

model AccountantStaffProof {
  id            String                       @id @default(cuid())
  companyId     String
  staffId       String
  kind          String                       @default("SMS")
  referenceNo   String
  transactionId String?
  amount        Decimal                      @default(0) @db.Decimal(18, 2)
  senderName    String?
  receiverName  String?
  transactionAt DateTime?
  smsText       String?                      @db.LongText
  proofUrl      String?                      @db.Text
  status        AccountantVerificationStatus @default(PENDING)
  reviewReason  String?                      @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([companyId, referenceNo])
  @@index([companyId, createdAt])
  @@index([companyId, staffId])
  @@index([companyId, status])
  @@map("accountant_staff_proofs")
}

model AccountantAdminPacket {
  id              String                       @id @default(cuid())
  companyId       String
  sentByAdminId   String
  sentByAdminName String
  targetType      AccountantPacketTarget
  targetId        String
  message         String                       @db.Text
  attachmentUrl   String?                      @db.Text
  status          AccountantVerificationStatus @default(PENDING)
  reviewReason    String?                      @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, targetType, targetId])
  @@index([companyId, status])
  @@map("accountant_admin_packets")
}

model AccountantBankDeposit {
  id                   String               @id @default(cuid())
  companyId            String
  staffId              String
  amount               Decimal              @db.Decimal(18, 2)
  referenceNo          String
  depositDate          DateTime
  bankAccount          String
  depositSlipUrl       String?              @db.Text
  bankReceiptUrl       String?              @db.Text
  status               AccountantBankStatus @default(PENDING)
  statementAmount      Decimal?             @db.Decimal(18, 2)
  statementReference   String?
  statementDate        DateTime?
  statementBankAccount String?
  bankStatementUrl     String?              @db.Text
  reviewReason         String?              @db.Text
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([companyId, referenceNo])
  @@index([companyId, createdAt])
  @@index([companyId, staffId])
  @@index([companyId, status])
  @@map("accountant_bank_deposits")
}

model AccountantIncomeEntry {
  id            String                 @id @default(cuid())
  companyId     String
  staffId       String
  amount        Decimal                @db.Decimal(18, 2)
  serviceType   String
  referenceNo   String
  sourceType    String                 @default("STAFF_SERVICE")
  sourceId      String?
  status        AccountantIncomeStatus @default(COMPLETED)
  transactionAt DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([companyId, referenceNo])
  @@index([companyId, transactionAt])
  @@index([companyId, staffId])
  @@map("accountant_income_entries")
}

model AccountantNotification {
  id         String                     @id @default(cuid())
  companyId  String
  userId     String?
  roleTarget String?
  title      String
  message    String                     @db.Text
  type       AccountantNotificationType @default(INFO)
  isRead     Boolean                    @default(false)
  readAt     DateTime?
  createdAt  DateTime                   @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, userId, isRead])
  @@index([companyId, roleTarget, isRead])
  @@map("accountant_notifications")
}

model AccountantPeriod {
  id             String                          @id @default(cuid())
  companyId      String
  label          String
  periodType     String                          @default("MONTH")
  startDate      DateTime
  endDate        DateTime
  status         AccountantPeriodStatus          @default(OPEN)
  reason         String?                         @db.Text
  lockedById     String?
  lockedAt       DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  reopenRequests AccountantPeriodReopenRequest[]

  @@unique([companyId, periodType, startDate, endDate])
  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
  @@map("accountant_periods")
}

model AccountantPeriodReopenRequest {
  id            String                 @id @default(cuid())
  companyId     String
  periodId      String
  requestedById String
  reason        String                 @db.Text
  status        AccountantReopenStatus @default(PENDING)
  reviewNote    String?                @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  period        AccountantPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([periodId, createdAt])
  @@map("accountant_period_reopen_requests")
}

model AccountantStaffMoneyEntry {
  id          String            @id @default(cuid())
  companyId   String
  staffId     String
  kind        AccMoneyKind
  direction   AccMoneyDirection
  amount      Decimal           @db.Decimal(18, 2)
  reference   String?
  note        String?           @db.Text
  enteredById String
  occurredAt  DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId, occurredAt])
  @@index([companyId, staffId])
  @@map("accountant_staff_money_entries")
}

model AccountantVerificationPacket {
  id                     String                @id @default(cuid())
  companyId              String
  staffId                String
  staffFileId            String?               @unique
  kind                   AccVerificationKind
  staffMessage           String?               @db.Text
  staffFileUrl           String?               @db.Text
  adminReferenceMessage  String?               @db.Text
  adminReferenceUrl      String?               @db.Text
  status                 AccVerificationStatus @default(WAITING_ADMIN_REFERENCE)
  accountantDecisionById String?
  decisionReason         String?               @db.Text
  decidedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([companyId, status])
  @@index([companyId, staffId])
  @@map("accountant_verification_packets")
}

model AccountantBankComparison {
  id                 String      @id @default(cuid())
  companyId          String
  depositId          String?     @unique
  staffId            String
  staffAmount        Decimal?    @db.Decimal(18, 2)
  staffReference     String?
  staffDate          DateTime?
  staffBankAccount   String?
  staffFileUrl       String?     @db.Text
  adminAmount        Decimal?    @db.Decimal(18, 2)
  adminReference     String?
  adminDate          DateTime?
  adminBankAccount   String?
  adminFileUrl       String?     @db.Text
  accountantDecision AccDecision @default(PENDING)
  mismatchReason     String?     @db.Text
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([companyId, accountantDecision])
  @@index([companyId, staffId])
  @@map("accountant_bank_comparisons")
}

model AccountantReportSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  createdById String
  reportName  String
  periodLabel String
  filtersJson Json
  payloadJson Json
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("accountant_report_snapshots")
}
