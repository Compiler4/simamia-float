+.agentActions button:nth-child(2) {
+  color: #734d0b;
+  background: #fff0c7;
+}
+
+.agentActions button:nth-child(3) {
+  color: #734d0b;
+  background: #fff0c7;
+}
+
+.agentActions button:nth-child(4) {
+  color: #5a3cad;
+  background: #eee8ff;
+}
+
+@media (max-width: 760px) {
+  .agent > .visited,
+  .agent > .serviced {
+    grid-column: 1 / -1;
+  }
+
+  .agentActions {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* v1.4: fill the dashboard workspace without creating another page viewport. */
+.embedded {
+  width: 100%;
+  min-width: 0;
+  overflow: visible;
+}
+
+.embedded .header {
+  top: auto;
+}
+
+@media (max-width: 760px) {
+  .embedded {
+    padding: 0;
+  }
+}
+
+/* v1.8: automatic visited/serviced database table. */
+.visitedTableCard {
+  max-width: 1680px;
+  margin: 14px auto 0;
+  padding: 18px;
+  border: 1px solid rgba(255, 255, 255, 0.92);
+  border-radius: 23px;
+  background:
+    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(240, 249, 245, 0.96));
+  box-shadow: 0 20px 54px rgba(28, 67, 57, 0.12);
+  -webkit-backdrop-filter: blur(18px);
+  backdrop-filter: blur(18px);
+}
+
+.visitedTableHeading {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 14px;
+  margin-bottom: 13px;
+}
+
+.visitedTableHeading small,
+.visitedTableHeading h3,
+.visitedTableHeading p {
+  display: block;
+  margin: 0;
+}
+
+.visitedTableHeading small {
+  color: #08795c;
+  font-size: 8px;
+  font-weight: 950;
+  letter-spacing: 0.1em;
+}
+
+.visitedTableHeading h3 {
+  margin-top: 4px;
+  font-size: 17px;
+}
+
+.visitedTableHeading p {
+  max-width: 920px;
+  margin-top: 5px;
+  color: #71827d;
+  font-size: 8.5px;
+  line-height: 1.55;
+}
+
+.visitedTableHeading > strong {
+  flex: 0 0 auto;
+  padding: 8px 11px;
+  border-radius: 999px;
+  color: #086343;
+  background: #dff6ec;
+  font-size: 8px;
+}
+
+.visitedTableScroll {
+  width: 100%;
+  max-height: min(62vh, 650px);
+  overflow: auto;
+  padding: 7px;
+  border: 1px solid #dce9e4;
+  border-radius: 17px;
+  background: #f3f8f6;
+}
+
+.visitedTableScroll table {
+  width: 100%;
+  min-width: 1320px;
+  border-collapse: separate;
+  border-spacing: 0 7px;
+}
+
+.visitedTableScroll th {
+  position: sticky;
+  top: 0;
+  z-index: 2;
+  padding: 12px 10px;
+  color: #fff;
+  background: linear-gradient(135deg, #0b7f61, #6848c8);
+  font-size: 7.5px;
+  font-weight: 950;
+  letter-spacing: 0.05em;
+  text-align: left;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+.visitedTableScroll th:first-child {
+  border-radius: 10px 0 0 10px;
+}
+
+.visitedTableScroll th:last-child {
+  border-radius: 0 10px 10px 0;
+}
+
+.visitedTableScroll td {
+  padding: 10px;
+  border-top: 1px solid #e1ebe7;
+  border-bottom: 1px solid #e1ebe7;
+  color: #35534a;
+  background: #fff;
+  font-size: 8px;
+  vertical-align: middle;
+  white-space: nowrap;
+}
+
+.visitedTableScroll tr {
+  transition:
+    transform 0.18s ease,
+    box-shadow 0.18s ease;
+}
+
+.visitedTableScroll tbody tr:hover {
+  transform: translateY(-1px);
+  box-shadow: 0 10px 24px rgba(41, 87, 75, 0.1);
+}
+
+.visitedTableScroll td strong,
+.visitedTableScroll td small {
+  display: block;
+}
+
+.visitedTableScroll td small {
+  margin-top: 3px;
+  color: #71827d;
+  font-size: 7px;
+}
+
+.visitedTableScroll button {
+  min-height: 32px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 5px;
+  padding: 0 9px;
+  border: 0;
+  border-radius: 9px;
+  color: #fff;
+  background: linear-gradient(135deg, #0a8f69, #075f49);
+  font: inherit;
+  font-size: 7px;
+  font-weight: 900;
+  cursor: pointer;
+}
+
+.visitedTableScroll button:disabled {
+  opacity: 0.48;
+  cursor: not-allowed;
+}
+
+.tableStatus {
+  width: fit-content;
+  display: inline-flex;
+  padding: 5px 7px;
+  border-radius: 999px;
+  color: #086343;
+  background: #dff6ec;
+  font-size: 6.5px;
+  font-weight: 900;
+}
+
+.embedded .visitedTableCard {
+  max-width: none;
+}
+
+@media (max-width: 760px) {
+  .visitedTableHeading {
+    flex-direction: column;
+  }
+
+  .visitedTableCard {
+    padding: 12px;
+    border-radius: 18px;
+  }
+
+  .visitedTableScroll {
+    max-height: none;
+    overflow: visible;
+    padding: 0;
+    border: 0;
+    background: transparent;
+  }
+
+  .visitedTableScroll table,
+  .visitedTableScroll thead,
+  .visitedTableScroll tbody,
+  .visitedTableScroll tr,
+  .visitedTableScroll th,
+  .visitedTableScroll td {
+    display: block;
+    width: 100%;
+    min-width: 0;
+  }
+
+  .visitedTableScroll thead {
+    display: none;
+  }
+
+  .visitedTableScroll table {
+    border-spacing: 0;
+  }
+
+  .visitedTableScroll tr {
+    display: grid;
+    gap: 8px;
+    margin-bottom: 10px;
+    padding: 12px;
+    border: 1px solid #dce9e4;
+    border-radius: 16px;
+    background: #ffffff;
+  }
+
+  .visitedTableScroll td {
+    display: grid;
+    grid-template-columns: 112px minmax(0, 1fr);
+    gap: 8px;
+    align-items: center;
+    padding: 0;
+    border: 0;
+    white-space: normal;
+  }
+
+  .visitedTableScroll td::before {
+    content: attr(data-label);
+    color: #71827d;
+    font-size: 7px;
+    font-weight: 950;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+  }
+
+  .visitedTableScroll button {
+    width: 100%;
+  }
+}
