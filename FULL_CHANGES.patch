+"use client";
+
+import {
+  type FormEvent,
+  type ReactNode,
+  useEffect,
+  useMemo,
+  useState,
+} from "react";
+import {
+  Activity,
+  ArrowLeft,
+  Banknote,
+  CheckCircle2,
+  ClipboardCopy,
+  Crosshair,
+  MapPinned,
+  Navigation,
+  RefreshCw,
+  Route,
+  Search,
+  Store,
+  Users,
+  Wifi,
+  WifiOff,
+  X,
+} from "lucide-react";
+import { useRouter, useSearchParams } from "next/navigation";
+
+import LiveMap, {
+  type LiveMapPoint,
+} from "./LiveMap";
+import styles from "./live-locations.module.css";
+
+type UserProps = {
+  id: string;
+  name: string;
+  email: string;
+  companyId: string;
+};
+
+type RegisteredAgent = {
+  id: string;
