+function currentPosition(): Promise<GeolocationPosition> {
+  return new Promise(
+    (resolve, reject) => {
+      if (!navigator.geolocation) {
+        reject(
+          new Error(
+            "This device does not support browser geolocation.",
+          ),
+        );
+        return;
+      }
+
+      navigator.geolocation.getCurrentPosition(
+        resolve,
+        reject,
+        {
+          enableHighAccuracy: true,
+          maximumAge: 5_000,
+          timeout: 25_000,
+        },
+      );
+    },
+  );
+}
