+  border-bottom: 1px solid #dce9e4;
+  box-shadow: 0 12px 30px rgba(40, 82, 72, 0.08);
+}
+
+.reveal {
+  padding-top: 3px;
+}
+
+.sidebar nav button {
+  transition:
+    color 0.18s ease,
+    background 0.18s ease,
+    transform 0.18s ease,
+    box-shadow 0.18s ease;
+}
+
+.sidebar nav button:hover {
+  transform: translateX(3px);
+}
+
+.activeNav {
+  box-shadow: 0 11px 24px rgba(10, 143, 105, 0.2);
+}
+
+/* Sidebar-wide period filter. It controls every staff data module using the same
+   Day / Week / Month / Year state, rather than each page silently using a
+   different period. */
+.sidebarFilter {
+  display: grid;
+  gap: 7px;
+  padding: 9px;
+  border: 1px solid #ffffff2c;
+  border-radius: 16px;
+  background: linear-gradient(145deg, #ffffff18, #ffffff0a);
+  box-shadow: inset 0 1px 0 #ffffff18;
+}
+.sidebarFilterTitle {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  color: #eafff8;
+  font-size: 8px;
+  font-weight: 900;
+  letter-spacing: .02em;
+}
+.sidebarFilter select,
+.sidebarFilter input {
+  min-width: 0;
+  width: 100%;
+  height: 34px;
+  padding: 0 9px;
+  border: 1px solid #ffffff38;
+  border-radius: 10px;
+  outline: none;
+  background: #ffffffed;
+  color: #17473b;
+  font: inherit;
+  font-size: 9px;
+  font-weight: 800;
+}
+.sidebarFilter button {
+  min-height: 34px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  border: 0;
+  border-radius: 10px;
+  background: #f6c85e;
+  color: #25463d;
+  font-size: 8px;
+  font-weight: 950;
+  cursor: pointer;
+  box-shadow: 0 8px 18px #123d2f2b;
+}
+.sidebarFilter button:disabled { opacity: .55; cursor: wait; }
+.sidebarFilter button:hover:not(:disabled) { transform: translateY(-1px); }
+.collapsed .sidebarFilter { display: none; }
+
+/* Staff UI V9: period filtering now lives in the main workspace, not the sidebar. */
+.mainPeriodFilter {
+  display: grid;
+  grid-template-columns: minmax(280px, 1.15fr) minmax(420px, .85fr);
+  gap: 18px;
+  align-items: center;
+  margin: 12px 18px 0;
+  padding: 16px 18px;
+  border: 1px solid rgba(255, 255, 255, .9);
+  border-radius: 22px;
+  background:
+    radial-gradient(circle at 0 0, rgba(10, 143, 105, .11), transparent 34%),
+    linear-gradient(135deg, rgba(255,255,255,.96), rgba(243,249,247,.91));
+  box-shadow: 0 18px 46px rgba(33, 85, 71, .10);
+  -webkit-backdrop-filter: blur(20px);
+  backdrop-filter: blur(20px);
+}
+
+.mainPeriodFilterIntro {
+  min-width: 0;
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr);
+  gap: 12px;
+  align-items: center;
+}
+
+.mainPeriodFilterIntro > span {
+  width: 46px;
+  height: 46px;
+  display: grid;
+  place-items: center;
+  border-radius: 15px;
+  color: #ffffff;
+  background: linear-gradient(145deg, #08795c, #0aa276);
+  box-shadow: 0 12px 25px rgba(10, 143, 105, .22);
+}
+
+.mainPeriodFilterIntro small,
+.mainPeriodFilterIntro strong,
+.mainPeriodFilterIntro p {
+  display: block;
+  margin: 0;
+}
+
+.mainPeriodFilterIntro small {
+  color: #0a7b5d;
+  font-size: 7px;
+  font-weight: 950;
+  letter-spacing: .09em;
+  text-transform: uppercase;
+}
+
+.mainPeriodFilterIntro strong {
+  margin-top: 3px;
+  color: #173b31;
+  font-size: 12px;
+  letter-spacing: -.015em;
+}
+
+.mainPeriodFilterIntro p {
+  margin-top: 4px;
+  color: #6d817a;
+  font-size: 7.5px;
+  line-height: 1.45;
+}
+
+.mainPeriodFilterFields {
+  display: grid;
+  grid-template-columns: minmax(120px, .7fr) minmax(160px, 1fr) auto;
+  gap: 9px;
+  align-items: end;
+}
+
+.mainPeriodFilterFields label {
+  min-width: 0;
+  display: grid;
+  gap: 5px;
+}
+
+.mainPeriodFilterFields label > span {
+  color: #5d756c;
+  font-size: 7px;
+  font-weight: 900;
+}
+
+.mainPeriodFilterFields select,
+.mainPeriodFilterFields input {
+  width: 100%;
+  height: 42px;
+  min-width: 0;
+  padding: 0 11px;
+  border: 1px solid #d8e6e1;
+  border-radius: 12px;
+  outline: none;
+  color: #173b31;
+  background: rgba(255,255,255,.98);
+  font: inherit;
+  font-size: 8.5px;
+  font-weight: 820;
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
+}
+
+.mainPeriodFilterFields select:focus,
+.mainPeriodFilterFields input:focus {
+  border-color: rgba(10, 143, 105, .55);
+  box-shadow: 0 0 0 3px rgba(10, 143, 105, .10);
+}
+
+.mainPeriodFilterFields button {
+  min-height: 42px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 0 15px;
+  border: 0;
+  border-radius: 12px;
+  color: #ffffff;
+  background: linear-gradient(135deg, #0a8f69, #075f49);
+  box-shadow: 0 11px 24px rgba(10, 112, 83, .20);
+  font: inherit;
+  font-size: 8px;
+  font-weight: 950;
+  cursor: pointer;
+  transition: transform .18s ease, box-shadow .18s ease;
+  white-space: nowrap;
+}
+
+.mainPeriodFilterFields button:hover:not(:disabled) {
+  transform: translateY(-2px);
+  box-shadow: 0 15px 28px rgba(10, 112, 83, .28);
+}
+
+.mainPeriodFilterFields button:disabled {
+  opacity: .55;
+  cursor: wait;
+}
+
+@media (max-width: 1050px) {
+  .mainPeriodFilter {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 700px) {
+  .mainPeriodFilter {
+    margin: 10px 10px 0;
+    padding: 14px;
+    border-radius: 18px;
+  }
+
+  .mainPeriodFilterFields {
+    grid-template-columns: 1fr;
+  }
+
+  .mainPeriodFilterFields button {
+    width: 100%;
+  }
+}
