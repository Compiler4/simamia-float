+} from "react";
+
+import LiveMap from "./LiveMap";
+import styles from "./StaffAdvancedOperations.module.css";
+
+type ViewName =
+  | "funding"
+  | "float"
+  | "settlement"
+  | "verification"
+  | "proofs"
+  | "documents"
+  | "expenses"
+  | "services"
+  | "transactions"
+  | "performance"
+  | "reports"
+  | "attendance"
+  | "gps"
+  | "travel"
+  | "alerts"
