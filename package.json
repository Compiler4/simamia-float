{
  "name": "simamia-float",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "postinstall": "node scripts/prisma-generate-safe.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "node scripts/prisma-generate-safe.mjs && next build",
    "start": "node scripts/start-next.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "prisma:generate": "node scripts/prisma-generate-safe.mjs",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:sync": "prisma db push",
    "db:migrate": "prisma migrate dev --name company_admin_v3",
    "import:agents": "tsx scripts/import-float-agents.ts",
    "import:crdb": "tsx scripts/import-crdb-statement.ts",
    "import:all": "tsx scripts/import-all-data.ts",
    "repair:v3": "node scripts/apply-v3-fixes.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:schema:sync": "prisma db push",
    "db:generate": "node scripts/prisma-generate-safe.mjs",
    "db:seed:all": "node scripts/run-all-seeds.mjs",
    "db:seed:data": "tsx prisma/seed-data-folder.ts",
    "db:seed:verify": "tsx prisma/verify-seeded-data.ts",
    "db:import:agents": "tsx prisma/import-float-agents-json.ts",
    "db:import:bank": "tsx prisma/import-bank-statement-json.ts",
    "local:repair-schema": "node scripts/repair-local-schema.mjs",
    "local:reset-passwords": "node scripts/reset-local-passwords.mjs",
    "local:setup": "npm run local:repair-schema && npm run local:reset-passwords",
    "github:check": "prisma validate && node scripts/prisma-generate-safe.mjs && tsc --noEmit --incremental false && next build",
    "db:fix:accountant-funding": "tsx scripts/ensure-accountant-staff-funding-table.ts",
    "check:routes": "node scripts/verify-app-routes.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "mariadb": "^3.5.3",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "postcss": "^8.5.23",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
