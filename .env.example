# Copy this file to .env.local for local development.
# Do not commit real production secrets.

DATABASE_URL="mysql://root:@127.0.0.1:3306/simamia?connection_limit=5"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="simamia"
DATABASE_CONNECTION_LIMIT="5"
# Keep this 0 on Vercel. Use 1 only on Hostinger/self-hosted Node servers
# where the app and MySQL run on the same machine and localhost is intentional.
ALLOW_LOCAL_DATABASE_IN_PRODUCTION="0"

AUTH_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

STAFF_GPS_TIME_ZONE="Africa/Dar_es_Salaam"
STAFF_GPS_MORNING_START="07:00"
STAFF_GPS_NIGHT_STOP="19:00"
STAFF_OFFLINE_MINUTES="15"
BROKER_SERVICE_RADIUS_METERS="150"
BROKER_ADDRESS_RADIUS_METERS="250"
BROKER_GPS_MAX_ACCURACY_METERS="150"
AGENT_GPS_MAX_ACCURACY_METERS="150"

EMAIL_NOTIFICATION_WEBHOOK_URL=""
SMS_NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_TOKEN=""
NOTIFICATION_WEBHOOK_SECRET=""
