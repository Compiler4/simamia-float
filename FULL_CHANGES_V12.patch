+function normaliseScope(value: unknown): string {
+  const scope = clean(value).toLowerCase();
+  if (["bank", "bank_deposit", "bank-deposit"].includes(scope)) return "deposit";
+  if (["collection", "float", "funding"].includes(scope)) return "transaction";
+  if (["payment", "payment_proof", "payment-proof"].includes(scope)) return "proof";
+  if (["document", "staff_file", "staff-file"].includes(scope)) return "file";
+  return scope;
+}
+
+function normaliseKind(value: unknown): string {
+  return clean(value).toUpperCase().replaceAll("-", "_").replaceAll(" ", "_");
+}
+
+function sameReference(left: unknown, right: unknown): boolean {
+  const a = clean(left).toLowerCase();
+  const b = clean(right).toLowerCase();
+  return Boolean(a && b && a === b);
+}
+
+function sameSource(left: unknown, right: unknown): boolean {
+  const normalise = (value: unknown) => {
+    const raw = clean(value);
+    if (!raw) return "";
+    try {
+      const decoded = decodeURIComponent(raw);
+      return decoded.split("#")[0].replaceAll("\\", "/").replace(/\/+$/, "");
+    } catch {
+      return raw.split("#")[0].replaceAll("\\", "/").replace(/\/+$/, "");
+    }
+  };
+  const a = normalise(left);
+  const b = normalise(right);
+  return Boolean(a && b && (a === b || a.endsWith(b) || b.endsWith(a)));
+}
