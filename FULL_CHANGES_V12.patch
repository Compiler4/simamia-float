+  if (kind === "EXPENSE") return candidate.scope === "expense";
+  if (["COLLECTION", "BROKER_COLLECTION", "FLOAT", "FLOAT_TRANSACTION", "STAFF_RETURN_TO_ACCOUNTANT"].includes(kind)) {
